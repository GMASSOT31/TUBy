{
  "name": "tuby",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler pages dev dist --port 8788",
    "dev:ui": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.cjs",
    "db:migrate:local": "wrangler d1 migrations apply tuby --local",
    "db:migrate": "wrangler d1 migrations apply tuby --remote",
    "db:seed:local": "node scripts/seed.mjs --local",
    "db:seed": "node scripts/seed.mjs --remote",
    "db:export": "wrangler d1 export tuby --remote --output sauvegarde-tuby.sql",
    "admin:password": "node scripts/admin-password.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0",
    "yaml": "^2.6.0"
  }
}
